{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Znormalizowane zlecenia mapowe",
  "description": "Jeden rekord na zgłoszenie, bez usuwania duplikatów. Null wymaga powodu. Kolejność bbox: west,south,east,north.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ticket_key",
      "country_code",
      "region_code",
      "spatial_scope",
      "layer",
      "data_release",
      "processing_step",
      "output_format",
      "deadline",
      "requester_team",
      "unknown_reasons"
    ],
    "properties": {
      "ticket_key": {
        "type": "string",
        "pattern": "^MAPJOB-[0-9]+$"
      },
      "country_code": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Z]{2}$"
      },
      "region_code": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
      },
      "spatial_scope": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "const": "admin_area"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "coordinates",
              "crs"
            ],
            "properties": {
              "kind": {
                "const": "bbox"
              },
              "crs": {
                "const": "EPSG:4326"
              },
              "coordinates": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false
              }
            }
          }
        ]
      },
      "layer": {
        "enum": [
          "roads",
          "poi",
          "speed_limits",
          "addresses",
          null
        ]
      },
      "data_release": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])$"
      },
      "processing_step": {
        "enum": [
          "ingest",
          "conflation",
          "validation",
          "export",
          null
        ]
      },
      "output_format": {
        "enum": [
          "GeoParquet",
          "GeoJSON",
          "CSV",
          "GPKG",
          null
        ]
      },
      "deadline": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "requester_team": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "unknown_reasons": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "country_code",
            "region_code",
            "spatial_scope",
            "layer",
            "data_release",
            "processing_step",
            "output_format",
            "deadline",
            "requester_team"
          ]
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "country_code": {
              "type": "null"
            }
          },
          "required": [
            "country_code"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "country_code"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "region_code": {
              "type": "null"
            }
          },
          "required": [
            "region_code"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "region_code"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "spatial_scope": {
              "type": "null"
            }
          },
          "required": [
            "spatial_scope"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "spatial_scope"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "layer": {
              "type": "null"
            }
          },
          "required": [
            "layer"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "layer"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "data_release": {
              "type": "null"
            }
          },
          "required": [
            "data_release"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "data_release"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "processing_step": {
              "type": "null"
            }
          },
          "required": [
            "processing_step"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "processing_step"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "output_format": {
              "type": "null"
            }
          },
          "required": [
            "output_format"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "output_format"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "deadline": {
              "type": "null"
            }
          },
          "required": [
            "deadline"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "deadline"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "requester_team": {
              "type": "null"
            }
          },
          "required": [
            "requester_team"
          ]
        },
        "then": {
          "properties": {
            "unknown_reasons": {
              "required": [
                "requester_team"
              ]
            }
          }
        }
      }
    ]
  }
}
